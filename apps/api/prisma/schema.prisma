generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  entityId   String
  entityType String
  actorId    String
  details    Json?
  createdAt  DateTime    @default(now())
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isActive      Boolean        @default(true)
  managedEvents Event[]        @relation("OrganizerEvents")
  vendorProfile VendorProfile?
}

model Event {
  id            String              @id @default(uuid())
  name          String
  slug          String              @unique
  description   String?
  startDate     DateTime
  endDate       DateTime
  location      String?
  mapImageUrl   String?
  layoutVersion Int                 @default(0)
  organizerId   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  status        EventStatus         @default(ACTIVE)
  booths        Booth[]
  organizer     User                @relation("OrganizerEvents", fields: [organizerId], references: [id])
  applications  VendorApplication[]
}

model VendorProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  businessName String
  description  String?
  category     String?
  phoneNumber  String?
  priceRange   String?
  dailyDrinkLimitEnabled Boolean @default(false)
  dailyDrinkLimitQuantity Int    @default(0)
  autoStopOrderingOnLimit Boolean @default(true)
  reportRecipientEmail String?
  booths       Booth[]
  menuItems    MenuItem[]
  orders       Order[]    @relation("VendorOrders")
  dailyUsages  VendorDailyUsage[]
  user         User       @relation(fields: [userId], references: [id])
}

model VendorDailyUsage {
  id             String        @id @default(uuid())
  vendorId       String
  date           String        // format: YYYY-MM-DD
  dailyLimit     Int
  usedQuantity   Int           @default(0)
  orderingClosed Boolean       @default(false)
  reportSentAt   DateTime?
  reportSentTo   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  vendor         VendorProfile @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, date])
}

model VendorApplication {
  id               String            @id @default(uuid())
  eventId          String
  applicantName    String
  applicantEmail   String
  businessName     String
  googleFormData   Json?
  status           ApplicationStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  accountCreatedAt DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  category         String?
  description      String?
  phoneNumber      String?
  priceMax         Float             @default(0)
  priceMin         Float             @default(0)
  inviteToken      InviteToken?
  event            Event             @relation(fields: [eventId], references: [id])
}

model Booth {
  id       String         @id @default(uuid())
  eventId  String
  vendorId String?
  name     String
  status   String
  x        Float          @default(0)
  y        Float          @default(0)
  width    Float          @default(10)
  height   Float          @default(10)
  showPrices Boolean      @default(true)
  event    Event          @relation(fields: [eventId], references: [id])
  vendor   VendorProfile? @relation(fields: [vendorId], references: [id])
}

model MenuItem {
  id          String        @id @default(uuid())
  vendorId    String
  name        String
  description String?
  price       Decimal
  imageUrl    String?
  isAvailable Boolean       @default(true)
  optionGroups Json?
  remarksEnabled Boolean    @default(true)
  displayOrder Int          @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  vendor      VendorProfile @relation(fields: [vendorId], references: [id])
  orderItems  OrderItem[]

  @@index([vendorId, displayOrder])
}

model Order {
  id            String        @id @default(uuid())
  customerId    String
  customerEmail String?
  vendorId      String
  displayNumber Int           @default(0)
  status        OrderStatus   @default(PREPARING)
  paymentMode   PaymentMode   @default(PAY_AT_BOOTH)
  paymentStatus PaymentStatus @default(PENDING)
  totalAmount   Decimal
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  acceptedAt    DateTime?
  completedAt   DateTime?
  readyAt       DateTime?
  vendor        VendorProfile @relation("VendorOrders", fields: [vendorId], references: [id])
  items         OrderItem[]

  @@unique([vendorId, displayNumber])
  @@index([vendorId, createdAt])
  @@index([status])
  @@index([completedAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal
  remark     String?
  selectedOptions Json?
  status     OrderItemStatus @default(PREPARING)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
}

model PushSubscription {
  id         String   @id @default(uuid())
  customerId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
}

model InviteToken {
  id            String             @id @default(uuid())
  token         String             @unique
  role          Role
  eventId       String?
  applicationId String?            @unique
  isUsed        Boolean            @default(false)
  expiresAt     DateTime
  email         String
  usedAt        DateTime?
  application   VendorApplication? @relation(fields: [applicationId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum Role {
  CUSTOMER
  VENDOR
  ORGANIZER
}

enum OrderStatus {
  PREPARING
  READY
}

enum OrderItemStatus {
  PREPARING
  READY
}

enum PaymentMode {
  PAY_AT_BOOTH
  MOCK_PAID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum AuditAction {
  ORDER_STATUS_CHANGE
  PAYMENT_STATUS_CHANGE
  BOOTH_ASSIGNMENT
  VENDOR_APPROVAL
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  ACCOUNT_CREATED
}

enum EventStatus {
  ACTIVE
  ARCHIVED
}
