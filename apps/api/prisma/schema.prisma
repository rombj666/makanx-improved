generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(VENDOR)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vendorProfile VendorProfile?
}

model VendorProfile {
  id           String         @id @default(uuid())
  userId       String         @unique
  businessName String
  description  String?
  category     String?
  phoneNumber  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings     VendorSettings?
  menuItems    MenuItem[]
  orders       Order[]
  dailyUsages  VendorDailyUsage[]
}

model VendorSettings {
  id                      String        @id @default(uuid())
  vendorId                String        @unique
  orderingOpen            Boolean       @default(true)
  dailyLimitEnabled       Boolean       @default(false)
  dailyLimitQuantity      Int           @default(0)
  dailyLimitAutoStop      Boolean       @default(true)
  deviceOrderLimitEnabled Boolean       @default(false)
  maxDrinksPerOrder       Int           @default(99)
  reportRecipientEmails   Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  vendor                  VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorDailyUsage {
  id             String        @id @default(uuid())
  vendorId       String
  date           String
  dailyLimit     Int
  usedQuantity   Int           @default(0)
  orderingClosed Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  vendor         VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, date])
}

model MenuItem {
  id             String        @id @default(uuid())
  vendorId       String
  name           String
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  imageUrl       String?
  isAvailable    Boolean       @default(true)
  optionGroups   Json?
  remarksEnabled Boolean       @default(true)
  displayOrder   Int           @default(0)
  basePrepMin    Int           @default(5)
  extraPerItemMin Int          @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  vendor         VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@index([vendorId, displayOrder])
}

model Order {
  id            String        @id @default(uuid())
  customerId    String
  customerName  String?
  customerPhone String?
  customerEmail String?
  deviceId      String?
  vendorId      String
  displayNumber Int
  status        OrderStatus   @default(PREPARING)
  paymentMode   PaymentMode   @default(PAY_AT_COUNTER)
  paymentStatus PaymentStatus @default(PENDING)
  totalAmount   Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  acceptedAt    DateTime?
  readyAt       DateTime?
  completedAt   DateTime?
  vendor        VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items         OrderItem[]

  @@index([vendorId, createdAt])
  @@index([vendorId, deviceId, createdAt])
  @@index([status])
}

model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  menuItemId      String
  quantity        Int
  price           Decimal         @db.Decimal(10, 2)
  remark          String?
  selectedOptions Json?
  status          OrderItemStatus @default(PREPARING)
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id])
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id         String   @id @default(uuid())
  customerId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum Role {
  VENDOR
}

enum OrderStatus {
  PREPARING
  READY
}

enum OrderItemStatus {
  PREPARING
  READY
}

enum PaymentMode {
  PAY_AT_COUNTER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
