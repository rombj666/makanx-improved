datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR
  ORGANIZER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  PAY_AT_BOOTH
  MOCK_PAID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum AuditAction {
  ORDER_STATUS_CHANGE
  PAYMENT_STATUS_CHANGE
  BOOTH_ASSIGNMENT
  VENDOR_APPROVAL
}

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  entityId  String
  entityType String     // "Order", "VendorApplication", "Booth"
  actorId   String
  details   Json?
  createdAt DateTime    @default(now())
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorProfile VendorProfile?
  orders        Order[]
  managedEvents Event[]        @relation("OrganizerEvents")
}

model Event {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  startDate     DateTime
  endDate       DateTime
  location      String?
  mapImageUrl   String?
  layoutVersion Int      @default(0)
  organizerId   String
  organizer   User     @relation("OrganizerEvents", fields: [organizerId], references: [id])
  
  booths      Booth[]
  applications VendorApplication[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VendorProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  businessName String
  description  String?
  
  menuItems    MenuItem[]
  booths       Booth[]
  orders       Order[]  @relation("VendorOrders")
}

model VendorApplication {
  id             String            @id @default(uuid())
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id])
  applicantName  String
  applicantEmail String
  businessName   String
  googleFormData Json?
  status         ApplicationStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  inviteToken    InviteToken?
}

model Booth {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  vendorId  String?
  vendor    VendorProfile? @relation(fields: [vendorId], references: [id])
  name      String
  status    String
  x         Float    @default(0)
  y         Float    @default(0)
  width     Float    @default(10)
  height    Float    @default(10)
}

model MenuItem {
  id             String        @id @default(uuid())
  vendorId       String
  vendor         VendorProfile @relation(fields: [vendorId], references: [id])
  name           String
  description    String?
  price          Decimal
  imageUrl       String?
  isAvailable    Boolean       @default(true)
  orderItems     OrderItem[]
}

model Order {
  id          String      @id @default(uuid())
  customerId  String
  customer    User        @relation(fields: [customerId], references: [id])
  vendorId    String
  vendor      VendorProfile @relation("VendorOrders", fields: [vendorId], references: [id])
  status      OrderStatus @default(PENDING)
  paymentMode PaymentMode @default(PAY_AT_BOOTH)
  paymentStatus PaymentStatus @default(PENDING)
  totalAmount Decimal
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  items       OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Decimal
  remark     String?
}

model InviteToken {
  id            String   @id @default(uuid())
  token         String   @unique
  role          Role
  eventId       String?
  applicationId String?  @unique
  application   VendorApplication? @relation(fields: [applicationId], references: [id])
  isUsed        Boolean  @default(false)
  expiresAt     DateTime
}
